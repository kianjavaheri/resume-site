) => {\n    if (theme === 'light') return false\n    return true\n  }\n  // theme stuff\n\n  return (\n    <div className=\"App\" data-theme={theme}>\n        <Navbar switchTheme={switchTheme} isChecked={isChecked}/>\n        <About/>\n        {/* <hr className=\"divider\"/> */}\n        {/* <Projects/> */}\n        <hr className=\"divider\"/>\n        <ProficiencyTest />\n        {/* <Proficiency/> */}\n        {/* <hr className=\"divider\"/>\n        <Contact /> */}\n        <ScrollButton/>\n    </div>\n  );\n}\n\nfunction App() {\n  const theme = useLocalStorage('theme', defaultDark ? 'light' : 'dark'); // loads default\n\n  return (\n    <div className=\"App\" data-theme={theme}>\n        <Routes>\n          <Route path=\"/\" element={<HomePage />} />\n        </Routes>\n    </div>\n  );\n}\n\nexport default App;\n",["56","57"],"/Users/kianjavaheri/Desktop/cs_garbage/resume-site/src/Components/Home/About.tsx",[],[],"/Users/kianjavaheri/Desktop/cs_garbage/resume-site/src/Components/Home/Scroll.tsx",[],[],"/Users/kianjavaheri/Desktop/cs_garbage/resume-site/src/Components/Home/Proficiency.tsx",[],[],"/Users/kianjavaheri/Desktop/cs_garbage/resume-site/src/Components/Home/Projects.tsx",[],[],"/Users/kianjavaheri/Desktop/cs_garbage/resume-site/src/Components/Home/Navbar.tsx",["58"],[],"/Users/kianjavaheri/Desktop/cs_garbage/resume-site/src/Components/Home/Contact.tsx",[],[],"/Users/kianjavaheri/Desktop/cs_garbage/resume-site/src/Components/Home/ProficiencyTest.tsx",["59","60","61","62","63","64","65"],[],"import React from 'react'\nimport pythonlogo from '../../svgs/pythonlogo.svg'\nimport javalogo from '../../svgs/javalogo.svg'\nimport javascriptlogo from '../../svgs/javascriptlogo.svg'\nimport reactlogo from '../../svgs/reactlogo.svg'\nimport cplogo from '../../svgs/cplogo.svg'\nimport gologo from '../../svgs/gologo.svg'\nimport cslogo from '../../svgs/cslogo.svg'\nimport sqllogo from '../../svgs/sqllogo.svg'\n\n\nfunction ProficiencyTest() {\n  return (\n    <div>\n        <section className=\"proficiencytest-container\">\n            <div className=\"proficiencytest-main\">\n                <div>\n                    \n                </div>\n                <h3>Python</h3>\n                <div className=\"lang-container\">\n                  <div className=\"skills python\"></div>\n                </div>\n                <img src={pythonlogo} className=\"lang-logo\" alt=\"python-logo\"></img>\n                <p>I would consider python 3 to be my most proficient language. I use python for pretty much every back-end job (except front-end logic). My strength definitely resides in data structures and algorithms, and python makes that very simple.</p>\n            </div>\n        </section>\n    </div>\n  )\n}\n\nexport default ProficiencyTest",{"ruleId":"66","replacedBy":"67"},{"ruleId":"68","replacedBy":"69"},{"ruleId":"70","severity":1,"message":"71","line":7,"column":8,"nodeType":"72","messageId":"73","endLine":7,"endColumn":15},{"ruleId":"70","severity":1,"message":"74","line":9,"column":8,"nodeType":"72","messageId":"73","endLine":9,"endColumn":19},{"ruleId":"70","severity":1,"message":"75","line":11,"column":8,"nodeType":"72","messageId":"73","endLine":11,"endColumn":16},{"ruleId":"66","replacedBy":"76"},{"ruleId":"68","replacedBy":"77"},{"ruleId":"78","severity":1,"message":"79","line":7,"column":13,"nodeType":"80","endLine":7,"endColumn":41},{"ruleId":"70","severity":1,"message":"81","line":3,"column":8,"nodeType":"72","messageId":"73","endLine":3,"endColumn":16},{"ruleId":"70","severity":1,"message":"82","line":4,"column":8,"nodeType":"72","messageId":"73","endLine":4,"endColumn":22},{"ruleId":"70","severity":1,"message":"83","line":5,"column":8,"nodeType":"72","messageId":"73","endLine":5,"endColumn":17},{"ruleId":"70","severity":1,"message":"84","line":6,"column":8,"nodeType":"72","messageId":"73","endLine":6,"endColumn":14},{"ruleId":"70","severity":1,"message":"85","line":7,"column":8,"nodeType":"72","messageId":